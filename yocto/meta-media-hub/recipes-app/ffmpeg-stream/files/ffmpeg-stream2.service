# ffmpeg-stream2.service
[Unit]
Description=FFmpeg Wyze Camera Stream 2
After=network.target

[Service]
ExecStart=/usr/bin/ffmpeg -fflags +discardcorrupt -rtsp_transport tcp -stimeout 5000000 \
  -i "rtsp://192.168.27.101:8554/360p" -map 0:v:0 -an -c:v copy -bsf:v h264_mp4toannexb \
  -f mpegts -avioflags direct "tcp://0.0.0.0:9091?listen=1"

Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.
